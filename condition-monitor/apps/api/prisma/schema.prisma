// Data model of the API (docs/domain-model.md). Tables arrive with the feature slices,
// one migration per change. What Prisma cannot express (CHECK constraints, partial and
// NULLS NOT DISTINCT indexes) is written as SQL in the migrations (ADR 0006).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Tables and columns are snake_case, the PostgreSQL convention, so hand-written SQL in
// the migrations never needs quoted identifiers. Prisma keeps camelCase in the code.

/// The fixed user of assumption A1, created by the seed. Every other record belongs to
/// a user (A4). The email is stored lowercase, so one address cannot exist twice with
/// different casing.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sectors      Sector[]

  @@map("users")
}

/// A physical area of the plant where machines are installed, in a single level
/// (assumption B9). The code is unique across the system, since it prefixes machine tags
/// (B10). A user who still owns sectors cannot be deleted: nothing cascades silently.
model Sector {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("sectors")
}
